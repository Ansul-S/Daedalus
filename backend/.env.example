# Daedalus runtime configuration
#
# Copy this file to `backend/.env` and adjust as needed:
#
#     cp .env.example .env
#
# Every variable is optional — the defaults below match those in
# `src/daedalus/config/settings.py`. All names use the DAEDALUS_ prefix.


# Application

DAEDALUS_APP_NAME=Daedalus
DAEDALUS_DEBUG=false

DAEDALUS_HOST=127.0.0.1
DAEDALUS_PORT=8000


# Models
#
# LLM, routing, and vision models are pulled via Ollama (`ollama pull <name>`).
# The embedding model is downloaded from HuggingFace on first use.

DAEDALUS_LLM_MODEL=qwen3:8b
DAEDALUS_ROUTING_MODEL=qwen3:4b
DAEDALUS_VISION_MODEL=qwen2.5vl:7b
DAEDALUS_EMBEDDING_MODEL=BAAI/bge-m3


# Services

DAEDALUS_OLLAMA_URL=http://localhost:11434


# Logging
#
# One of: DEBUG, INFO, WARNING, ERROR, CRITICAL

DAEDALUS_LOG_LEVEL=INFO
