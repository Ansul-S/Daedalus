# Copy to .env and fill in what you need:  cp env.example .env
# Everything is optional locally. Empty values fall back to the defaults shown here,
# which match docker-compose.yml and `make ollama`.

# "local" (Ollama available) or "production" (free cloud host: cloud models only, no ingestion)
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://daedalus:daedalus@localhost:5433/daedalus

# Local models served by Ollama
OLLAMA_BASE_URL=http://localhost:11434
GRADER_MODEL=qwen3.5:9b
HELPER_MODEL=qwen3.5:4b
SECOND_OPINION_MODEL=gemma4:12b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_NUM_CTX=2048

# Free cloud models
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Ingestion (local only)
DATA_DIR=
MAX_UPLOAD_MB=50
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=800
TOKENIZER_MODEL=Qwen/Qwen3-Embedding-0.6B
