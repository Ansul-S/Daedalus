# Copy to .env and fill in what you need:  cp env.example .env
# Everything is optional locally. Empty values fall back to the defaults shown here,
# which match docker-compose.yml and `make ollama`.

# "local" (Ollama available) or "production" (free cloud host: cloud models only, no ingestion)
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]
DATABASE_URL=postgresql+psycopg://daedalus:daedalus@localhost:5433/daedalus
# The path a proxy serves the API under and passes on with each request (/api when deployed);
# empty, the API answers at the root
ROOT_PATH=

# Sign-in with GitHub (optional locally: without it, practice is the built-in user's). Better
# Auth runs in the frontend, which reads this file too; the API checks the tokens it issues.
# Needs all four. A GitHub OAuth app (Settings, Developer settings, OAuth Apps) with homepage
# http://localhost:3000 and callback http://localhost:3000/auth/callback/github; the secret is
# any long random string, e.g. from `openssl rand -base64 32`.
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local models served by Ollama
OLLAMA_BASE_URL=http://localhost:11434
GRADER_MODEL=qwen3.5:9b
HELPER_MODEL=qwen3.5:4b
SECOND_OPINION_MODEL=gemma4:12b
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_NUM_CTX=2048

# Free cloud models
# Groq key: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_GRADING_MODEL=qwen/qwen3.8-27b
# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Tracing model calls to Langfuse (optional). Keys: a project's settings, "API Keys", on
# https://cloud.langfuse.com. With both set, every model call is traced: timings, tokens,
# models and prompt versions, without prompts or answers unless LANGFUSE_CONTENT=true.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_CONTENT=false
LANGFUSE_TRACING_ENABLED=true

# Ingestion (local only). Empty DATA_DIR means data/ in the repository.
DATA_DIR=
MAX_UPLOAD_MB=50
CHUNK_MIN_TOKENS=300
CHUNK_MAX_TOKENS=800
TOKENIZER_MODEL=Qwen/Qwen3-Embedding-0.6B

# Question generation. How close two concept tags have to be to become one topic, and above
# which similarity two questions are the same question in other words.
TOPIC_SIMILARITY=0.8
DUPLICATE_SIMILARITY=0.75

# Practice. The time zone practice days are counted in, as an IANA name (e.g. Asia/Kolkata);
# a day starts at 04:00 there.
PRACTICE_TIMEZONE=UTC

# Daily limits on grading, so that visitors share the free tiers: grades per user in a
# practice day, and grades by everyone together over the last 24 hours. Left empty, grading
# is not limited locally and is held to 10 and 80 in production; 0 switches grading off.
DAILY_GRADES_PER_USER=
DAILY_GRADES=

# Testing only: stand-ins for every model. What they write is made up, so use them on a
# throwaway database. Refused with ENVIRONMENT=production.
FAKE_MODELS=false

# Deployed on Vercel (vercel.json: one project, the frontend at / and the API at /api), the
# settings go in the project's environment variables rather than a file. Besides the keys above:
#   ENVIRONMENT=production
#   DATABASE_URL=<Neon's pooled connection string, written postgresql+psycopg://...>
#   ROOT_PATH=/api
#   NEXT_PUBLIC_API_URL=/api              the browser's address for the API, fixed at build time
#   API_URL=https://<domain>/api          the server side's, for the setup page: absolute
#   SITE_URL=https://<domain>
#   BETTER_AUTH_URL=https://<domain>, a new BETTER_AUTH_SECRET, and the client id and secret of
#   a GitHub OAuth app for the domain (callback https://<domain>/auth/callback/github)
# Left unset there, the daily limits hold grading to 10 a user and 80 in all.
