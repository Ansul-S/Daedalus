{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["cle1"],
  "services": {
    "web": {
      "root": "frontend/"
    },
    "api": {
      "root": "backend/",
      "entrypoint": "app.main:app",
      "functions": {
        "app/main.py": {
          "maxDuration": 300,
          "excludeFiles": "{tests,scripts}/**"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "git": {
    "deploymentEnabled": { "**": false, "main": true }
  }
}
